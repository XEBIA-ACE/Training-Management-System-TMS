# Copy to .env (never commit .env). Values below are local placeholders only.
# The service starts with none of these set; they only enable optional integrations.

# Feature toggle (ExternalIntegrationsAclProperties.enabled)
TMS_ACL_ENABLED=true
TMS_ACL_SERVER_PORT=8082

# Persistence (only used with SPRING_PROFILES_ACTIVE=persistence)
# SPRING_PROFILES_ACTIVE=persistence
TMS_ACL_DB_URL=jdbc:postgresql://localhost:5432/tms
TMS_ACL_DB_USERNAME=tms_acl
TMS_ACL_DB_PASSWORD=change-me

# Security: bearer JWT from the central IdP (leave empty to reject all /api/** calls)
TMS_ACL_JWT_ISSUER_URI=
TMS_ACL_JWT_JWK_SET_URI=

# Messaging placeholder (no broker client is wired yet)
TMS_ACL_MESSAGING_ENABLED=false

# Observability (OpenTelemetry OTLP exporter is enabled only when the endpoint is set)
MANAGEMENT_OTLP_TRACING_ENDPOINT=
TMS_ACL_TRACING_SAMPLING_PROBABILITY=1.0
