# Copy to .env (never commit .env). Values below are local placeholders only.
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (OLTP database holding the outbox table)
TMS_OUTBOX_DB_URL=jdbc:postgresql://localhost:5433/tms_outbox
TMS_OUTBOX_DB_USERNAME=tms_outbox
TMS_OUTBOX_DB_PASSWORD=change-me
TMS_OUTBOX_DB_SCHEMA=outbox
TMS_OUTBOX_DB_MIGRATIONS_ENABLED=true

# Processing
TMS_OUTBOX_BATCH_SIZE=100
TMS_OUTBOX_POLLING_INTERVAL_MS=5000
TMS_OUTBOX_SCHEDULER_CRON=0 0 * * * *
TMS_OUTBOX_RETRY_MAX_ATTEMPTS=5
TMS_OUTBOX_RETRY_BACKOFF_MS=1000
TMS_OUTBOX_CLEANUP_RETENTION_DAYS=7
TMS_OUTBOX_PROCESSOR_AUTO_START=true
# none | rabbitmq | kafka (broker adapters are stubs, TODO SCAFFOLD-SVC-002)
TMS_OUTBOX_PUBLISHER_TYPE=none

# Security: bearer JWT from the central IdP
TMS_OUTBOX_JWT_ISSUER_URI=
TMS_OUTBOX_JWT_JWK_SET_URI=
TMS_OUTBOX_JWT_AUDIENCES=
TMS_OUTBOX_JWT_REQUIRED=false

# Observability (OpenTelemetry OTLP exporter is enabled only when the endpoint is set)
MANAGEMENT_OTLP_TRACING_ENDPOINT=
TMS_OUTBOX_TRACING_SAMPLING_PROBABILITY=1.0
TMS_OUTBOX_SERVER_PORT=8081
