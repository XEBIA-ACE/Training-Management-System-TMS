# Copy to .env (git-ignored) and adjust. Never commit real credentials.
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (TMS primary database)
TMS_DB_URL=jdbc:postgresql://localhost:5432/tms
TMS_DB_USERNAME=tms
TMS_DB_PASSWORD=change-me
TMS_DB_SCHEMA=tms

# Redis (Spring Cache). The local profile defaults TMS_CACHE_TYPE to "simple".
TMS_REDIS_URL=redis://localhost:6379
# TMS_CACHE_TYPE=redis
# TMS_REDIS_HEALTH_ENABLED=true

# OAuth2 Resource Server (bearer JWT from the enterprise IdP)
# TMS_JWT_ISSUER_URI=https://login.example.com/<tenant>/v2.0
# TMS_JWT_JWK_SET_URI=
# TMS_JWT_AUDIENCES=api://tms-core-service
# TMS_JWT_REQUIRED=true
# TMS_JWT_ROLE_CLAIMS=roles,groups,app_roles
# TMS_JWT_TENANT_CLAIM=tid

# Legacy /api/auth/login and /api/auth/refresh (non-SSO environments only)
# TMS_LEGACY_AUTH_ENABLED=false

# OpenAPI / Swagger UI
# TMS_OPENAPI_ENABLED=false
# TMS_OPENAPI_PUBLIC=false

# Logging: structured console format (ecs | logstash | gelf); empty for plain text.
# TMS_LOG_FORMAT=ecs
