# ACE_For TMS frontend-app configuration (SCAFFOLD-frontend-app, T002).
# Copy to .env.local and fill in per environment. Never commit real values.
# Only variables prefixed with VITE_TMS_ are exposed to the browser bundle;
# do NOT put secrets here -- anything in a SPA bundle is public.

# Deployment environment label shown in the shell header (e.g. local, dev, qa, prod).
VITE_TMS_APP_ENV=

# Base URL of the TMS API gateway / tms-core-service. Left empty: no API calls are made yet.
VITE_TMS_API_BASE_URL=

# Comma-separated list of enabled feature flags (e.g. flagA,flagB). Empty = none.
VITE_TMS_FEATURE_FLAGS=

# Idle session timeout in minutes before SCR-002 is shown. TODO(AUTH-02): value TBD; empty = disabled.
VITE_TMS_SESSION_TIMEOUT_MINUTES=
